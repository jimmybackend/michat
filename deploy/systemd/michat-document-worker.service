[Unit]
Description=MiChat central document knowledge bounded worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Review User/Group, PHP binary, and filesystem/S3 permissions before installing.
# Load the same private DB and AWS environment already used by MiChat on EC2.
User=apache
Group=apache
WorkingDirectory=/var/www/michat
EnvironmentFile=/etc/michat.env
Environment=MICHAT_DOCUMENT_KNOWLEDGE_ENABLED=1
ExecStart=/usr/bin/php /var/www/michat/michat/bin/document_knowledge_worker.php --max-batches=12
TimeoutStartSec=30min
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp
UMask=0077
